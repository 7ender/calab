# ==============================================================
# Calab nginx frontend
#
# Replaces the HTTP/static part of the current Caddy deployment.
#
# TLS:
#   Traefik / Dokploy
#
# HTTP:
#   nginx
#
# Hosts:
#   APP_HOST
#   DOMAIN
#   DOMAIN_ALT
#   DOMAIN_LEGACY
#   LANDING_HOST
#   RELEASES_HOST
#
# envsubst:
#   only explicitly exported environment variables are replaced.
#   nginx runtime variables remain untouched.
# ==============================================================


# ==============================================================
# Resolver
#
# Required for proxy_pass with a runtime variable when
# S3_PUBLIC_URL contains a hostname.
#
# Docker user-defined networks expose the embedded DNS resolver
# at 127.0.0.11.
# ==============================================================

resolver 127.0.0.11 valid=30s ipv6=off;

resolver_timeout 5s;


# ==============================================================
# APP STATIC CACHE
# ==============================================================

map $uri $calab_cache_control {
    default     "no-cache";
    ~^/assets/  "public, max-age=31536000, immutable";
}


# ==============================================================
# RELEASE HOST ENABLED
#
# RELEASES_HOST_EFFECTIVE:
#   non-empty -> release host exists
#   empty     -> no release host
# ==============================================================

map "${RELEASES_HOST_EFFECTIVE}" $calab_releases_enabled {
    ""      0;
    default 1;
}


# ==============================================================
# S3 RELEASE MODE
#
# S3_PUBLIC_URL:
#   empty -> local /srv/releases
#   set   -> proxy to S3-compatible public bucket
# ==============================================================

map "${S3_PUBLIC_URL}" $calab_s3_enabled {
    ""      0;
    default 1;
}


# ==============================================================
# LANDING ENABLED
# ==============================================================

map "${LANDING_HOST}" $calab_landing_enabled {
    ""      0;
    default 1;
}


# ==============================================================
# DOWNLOAD USER-AGENT SHORTCUTS
#
# Used only for:
#
#   /download/
#
# Stable shortcuts are handled separately.
# ==============================================================

map $http_user_agent $calab_download_url {
    default "";

    ~*Macintosh
      "https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-arm64.dmg";

    ~*Windows
      "https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-win-x64.exe";

    ~*(Linux|X11)
      "https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-linux-x86_64.AppImage";
}


# ==============================================================
# S3 REQUEST URI
#
# Caddy maps:
#
#   /
#       -> /index.html
#
# everything else:
#       -> original URI
# ==============================================================

map $request_uri $calab_s3_uri {
    "/"      "/index.html";
    default  $request_uri;
}


# ==============================================================
# LANDING
#
# IMPORTANT:
# This server comes before the app server intentionally.
#
# If LANDING_HOST == DOMAIN, landing must win for that Host.
# ==============================================================

server {
    listen 80;

    server_name ${LANDING_HOST:-__calab_landing_disabled__};

    root /srv/landing;

    server_tokens off;

    # HSTS.
    add_header Strict-Transport-Security \
        "max-age=31536000; includeSubDomains" always;

    # ----------------------------------------------------------
    # Security headers
    # ----------------------------------------------------------

    add_header Content-Security-Policy \
        "default-src 'self'; \
         script-src 'self' 'unsafe-inline'; \
         style-src 'self' 'unsafe-inline'; \
         img-src 'self' data: blob:; \
         font-src 'self' data:; \
         connect-src 'self' https://${RELEASES_HOST_EFFECTIVE}; \
         frame-ancestors 'none'; \
         base-uri 'self'; \
         form-action 'self'" always;

    add_header X-Content-Type-Options "nosniff" always;

    add_header Referrer-Policy \
        "strict-origin-when-cross-origin" always;

    add_header X-Frame-Options "DENY" always;

    add_header Permissions-Policy \
        "camera=(), microphone=(), geolocation=()" always;


    # ----------------------------------------------------------
    # /download
    #
    # Same release feed as the application host.
    # ----------------------------------------------------------

    location = /download {
        return 308 /download/;
    }


    location /download/ {

        # ------------------------------------------------------
        # Stable shortcuts.
        # ------------------------------------------------------

        location = /download/mac-arm64 {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-arm64.dmg;
        }

        location = /download/mac-arm64/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-arm64.dmg;
        }

        location = /download/mac-x64 {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-x64.dmg;
        }

        location = /download/mac-x64/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-x64.dmg;
        }

        location = /download/win {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-win-x64.exe;
        }

        location = /download/win/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-win-x64.exe;
        }

        location = /download/linux {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-linux-x86_64.AppImage;
        }

        location = /download/linux/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-linux-x86_64.AppImage;
        }

        location = /download/deb {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/calab-linux-amd64.deb;
        }

        location = /download/deb/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/calab-linux-amd64.deb;
        }


        # ------------------------------------------------------
        # /download/:
        #
        # choose installer by User-Agent.
        # ------------------------------------------------------

        location = /download/ {

            if ($calab_releases_enabled = 0) {
                try_files $uri =404;
            }

            if ($calab_download_url != "") {
                return 302 $calab_download_url;
            }

            # With a landing and no recognized desktop OS,
            # preserve Caddy's fallback to the landing.
            if ($calab_landing_enabled = 1) {
                return 302 https://${LANDING_HOST}/#download;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/;
        }


        # ------------------------------------------------------
        # Electron updater feed / arbitrary release files.
        #
        # When a release host exists, preserve the same path.
        # ------------------------------------------------------

        location ~ ^/download/(.*)$ {

            if ($calab_releases_enabled = 0) {
                try_files $uri =404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/$1;
        }
    }


    # ----------------------------------------------------------
    # Landing canonical locale URLs.
    # ----------------------------------------------------------

    location = /ru {
        return 308 /ru/;
    }

    location = /en {
        return 308 /en/;
    }

    location = /es {
        return 308 /es/;
    }

    location = /zh {
        return 308 /zh/;
    }


    # ----------------------------------------------------------
    # Next.js static export.
    # ----------------------------------------------------------

    location / {

        # Hashed Next.js assets.
        location ^~ /_next/static/ {
            try_files $uri =404;

            add_header Cache-Control \
                "public, max-age=31536000, immutable";
        }

        # Normal pages.
        try_files $uri $uri.html $uri/index.html /404.html;

        add_header Cache-Control "no-cache";
    }
}


# ==============================================================
# APPLICATION
#
# API itself is NOT served by nginx.
# Traefik routes /api /gateway /healthz directly to api:3000.
#
# nginx only sees the remaining static requests.
# ==============================================================

server {
    listen 80;

    server_name
        ${APP_HOST:-${DOMAIN}}
        ${DOMAIN}
        ${DOMAIN_ALT}
        ${DOMAIN_LEGACY};

    root /usr/share/nginx/html;

    index index.html;

    server_tokens off;


    # ----------------------------------------------------------
    # Compression
    # ----------------------------------------------------------

    gzip on;

    gzip_comp_level 6;

    gzip_min_length 1024;

    gzip_types
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml
        application/wasm
        text/plain;


    # ----------------------------------------------------------
    # HSTS
    # ----------------------------------------------------------

    add_header Strict-Transport-Security \
        "max-age=31536000; includeSubDomains" always;


    # ----------------------------------------------------------
    # Security headers
    #
    # RTC origins are derived from DOMAIN exactly like the
    # current Caddy entrypoint.
    # ----------------------------------------------------------

    add_header Content-Security-Policy \
        "default-src 'self'; \
         script-src 'self' 'wasm-unsafe-eval'; \
         connect-src 'self' wss://rtc.${DOMAIN} https://rtc.${DOMAIN}; \
         img-src 'self' blob: data:; \
         media-src 'self' blob:; \
         worker-src 'self' blob:; \
         style-src 'self' 'unsafe-inline'; \
         frame-src https:; \
         frame-ancestors 'none'; \
         base-uri 'self'; \
         form-action 'self'" always;

    add_header X-Content-Type-Options "nosniff" always;

    add_header Referrer-Policy \
        "same-origin" always;

    add_header X-Frame-Options "DENY" always;

    add_header Permissions-Policy \
        "microphone=(self), \
         display-capture=(self), \
         speaker-selection=(self), \
         autoplay=(self)" always;


    # ----------------------------------------------------------
    # Web manifest MIME type.
    # ----------------------------------------------------------

    location = /manifest.webmanifest {
        default_type application/manifest+json;

        try_files $uri =404;

        add_header Cache-Control "no-cache";
    }


    # ----------------------------------------------------------
    # /download
    # ----------------------------------------------------------

    location = /download {
        return 308 /download/;
    }


    location /download/ {

        # Stable installer shortcuts.

        location = /download/mac-arm64 {
            if ($calab_releases_enabled = 0) {
                try_files $uri =404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-arm64.dmg;
        }

        location = /download/mac-arm64/ {
            if ($calab_releases_enabled = 0) {
                try_files $uri =404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-arm64.dmg;
        }

        location = /download/mac-x64 {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-x64.dmg;
        }

        location = /download/mac-x64/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-mac-x64.dmg;
        }

        location = /download/win {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-win-x64.exe;
        }

        location = /download/win/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-win-x64.exe;
        }

        location = /download/linux {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-linux-x86_64.AppImage;
        }

        location = /download/linux/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/Calab-linux-x86_64.AppImage;
        }

        location = /download/deb {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/calab-linux-amd64.deb;
        }

        location = /download/deb/ {
            if ($calab_releases_enabled = 0) {
                return 404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/latest/calab-linux-amd64.deb;
        }


        # User-Agent based /download/.

        location = /download/ {

            if ($calab_releases_enabled = 0) {
                try_files $uri =404;
            }

            if ($calab_download_url != "") {
                return 302 $calab_download_url;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/;
        }


        # Electron updater:
        #
        # /download/latest.yml
        # /download/latest-linux.yml
        # /download/releases/...
        #
        # All go to the release host preserving the path.

        location ~ ^/download/(.*)$ {

            if ($calab_releases_enabled = 0) {
                try_files $uri =404;
            }

            return 302 https://${RELEASES_HOST_EFFECTIVE}/$1;
        }
    }


    # ----------------------------------------------------------
    # Static assets.
    #
    # A missing hashed asset MUST be a real 404.
    # ----------------------------------------------------------

    location ^~ /assets/ {

        try_files $uri =404;

        add_header Cache-Control \
            "public, max-age=31536000, immutable";
    }


    # ----------------------------------------------------------
    # Everything else:
    #
    # index.html
    # SPA routes
    # favicon
    # etc.
    #
    # No-cache matches the Caddy deployment.
    # ----------------------------------------------------------

    location / {

        try_files $uri /index.html;

        add_header Cache-Control "no-cache";
    }
}


# ==============================================================
# RELEASE HOST
#
# Only active when RELEASES_HOST_EFFECTIVE is non-empty.
#
# If S3_PUBLIC_URL is set:
#   proxy to public S3 bucket.
#
# Otherwise:
#   serve /srv/releases.
# ==============================================================

server {
    listen 80;

    server_name ${RELEASES_HOST_EFFECTIVE:-__calab_releases_disabled__};

    root /srv/releases;

    server_tokens off;


    # ----------------------------------------------------------
    # Security headers
    # ----------------------------------------------------------

    add_header Strict-Transport-Security \
        "max-age=31536000; includeSubDomains" always;

    add_header X-Content-Type-Options "nosniff" always;


    # ----------------------------------------------------------
    # Landing redirect for release root/listings.
    #
    # This mirrors Caddy's:
    #
    #   / */ /index.html
    #
    # when LANDING_HOST is configured.
    # ----------------------------------------------------------

    location = / {

        if ($calab_landing_enabled = 1) {
            return 302 https://${LANDING_HOST}/#download;
        }

        # S3 root.
        if ($calab_s3_enabled = 1) {
            return 302 https://${LANDING_HOST}/#download;
        }

        try_files /index.html =404;
    }


    location = /index.html {

        if ($calab_landing_enabled = 1) {
            return 302 https://${LANDING_HOST}/#download;
        }

        if ($calab_s3_enabled = 1) {
            return 302 https://${LANDING_HOST}/#download;
        }

        try_files $uri =404;

        add_header Cache-Control "no-cache";
    }


    # ----------------------------------------------------------
    # YAML / JSON metadata.
    # ----------------------------------------------------------

    location ~* \.(?:yml|yaml|json)$ {

        if ($calab_s3_enabled = 1) {
            return 418;
        }

        default_type application/json;

        try_files $uri =404;

        add_header Cache-Control "no-cache";
    }


    # ----------------------------------------------------------
    # Binary release files.
    # ----------------------------------------------------------

    location ~* \.(?:dmg|AppImage|deb|exe|blockmap)$ {

        if ($calab_s3_enabled = 1) {
            return 418;
        }

        default_type application/octet-stream;

        try_files $uri =404;

        add_header Cache-Control \
            "public, max-age=31536000, immutable";
    }


    # ----------------------------------------------------------
    # /latest/*
    #
    # latest is overwritten on every release, so it is mutable.
    # ----------------------------------------------------------

    location ^~ /latest/ {

        if ($calab_s3_enabled = 1) {
            return 418;
        }

        try_files $uri =404;

        add_header Cache-Control "no-cache";
    }


    # ----------------------------------------------------------
    # Generic local release files.
    # ----------------------------------------------------------

    location / {

        if ($calab_s3_enabled = 1) {
            return 418;
        }

        try_files $uri =404;

        add_header Cache-Control \
            "public, max-age=31536000, immutable";
    }


    # ----------------------------------------------------------
    # S3 fallback.
    #
    # 418 is used only as an internal branch.
    # ----------------------------------------------------------

    error_page 418 = @calab_s3;


    location @calab_s3 {

        # Caddy maps release root to index.html.
        #
        # For all other requests preserve the original URI.
        set $calab_s3_target \
            "${S3_PUBLIC_URL}$calab_s3_uri";

        proxy_ssl_server_name on;

        proxy_ssl_name $proxy_host;

        proxy_set_header Host $proxy_host;

        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Proto https;

        proxy_pass $calab_s3_target;

        # Caddy's S3 proxy adds no-cache to metadata/latest
        # and immutable cache headers to release binaries.

        add_header Access-Control-Allow-Origin "*" always;
    }
}
