# Caddy + caddy-l4 as a listener wrapper. One IP, TCP 443:
#   SNI turn.<any domain> -> layer4: terminate TLS here, proxy plain TURN to LiveKit 127.0.0.1:5349
#                        (LiveKit runs with turn.external_tls: true)
#   anything else     -> falls through to the regular HTTPS server (<domain>, rtc.*)
# HTTP/3 is disabled: UDP 443 belongs to LiveKit TURN/UDP.
# Host lists come from entrypoint.sh: APP_HOSTS = <domain>, RTC_HOSTS / TURN_HOSTS = rtc.|turn.<domain>, for each of
# DOMAIN (primary), DOMAIN_ALT (alias), DOMAIN_LEGACY (temporary) — see compose.yml / .env.
{
	admin off
	log {
		output stdout
		format json
	}
	servers :443 {
		listener_wrappers {
			layer4 {
				@turn tls sni {$TURN_HOSTS}
				route @turn {
					tls
					proxy 127.0.0.1:5349
				}
			}
			# must come after layer4 so SNI routing sees the raw ClientHello
			tls
		}
		protocols h1 h2
	}
}

{$APP_HOSTS} {
	# Prometheus metrics of the API are internal (scrape 127.0.0.1:3000/metrics on the host).
	# Inside handle: a bare `respond` sorts after `handle` and would never run.
	handle /metrics {
		respond 404
	}

	# Go API (host network): REST, gateway WS, health.
	@api path /api/* /gateway /healthz /readyz
	handle @api {
		reverse_proxy 127.0.0.1:3000
	}

	# Web client SPA (ADR-0015): static files from /srv/web (pushed by sync.sh).
	handle {
		root * /srv/web
		# Static only (API responses incl. file downloads with Range stay untouched).
		encode zstd gzip
		header {
			# 'wasm-unsafe-eval': RNNoise noise suppression (WASM in the mic AudioWorklet).
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'{$RTC_ORIGINS}; img-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			X-Frame-Options DENY
			Permissions-Policy "microphone=(self), display-capture=(self), speaker-selection=(self), autoplay=(self)"
			-Server
		}
		# Vite puts content-hashed files under /assets/: cache forever; a missing asset is a 404,
		# never index.html (otherwise a stale index would get HTML cached as JS for a year).
		handle /assets/* {
			@found file
			header @found Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# Everything else (index.html, SPA routes, favicon…) must be revalidated on each load.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}

{$RTC_HOSTS} {
	# LiveKit signal (WSS)
	reverse_proxy 127.0.0.1:7880
}

{$TURN_HOSTS} {
	# Exists only so Caddy obtains and renews the turn.* certificates used by the layer4 route above.
	respond 404
}
