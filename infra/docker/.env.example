# Скопировать в infra/docker/.env на хосте. Не коммитить.
# Домены (docs/10-branding.md). DOMAIN даёт rtc.<DOMAIN> и turn.<DOMAIN> (TURN анонсируется по нему).
# На стенде: DOMAIN=calab.ru, APP_HOST=app.calab.ru, LANDING_HOST=calab.ru
DOMAIN=calab.example.com
# Приложение (веб-клиент, API, gateway, /download/); пусто = DOMAIN
APP_HOST=
# Лендинг (статика apps/landing/out); пусто = без лендинга
LANDING_HOST=
# Дополнительный хост приложения (алиас, опционально; его rtc./turn. тоже обслуживаются). На стенде: colaba.gptunnel.ai
DOMAIN_ALT=
# Ещё один дополнительный хост приложения на время переезда (опционально). На стенде: colaba.gptunnel.ru
DOMAIN_LEGACY=
LIVEKIT_API_KEY=                     # "API" + `openssl rand -hex 6`, например APIa1b2c3d4e5f6
LIVEKIT_API_SECRET=                  # `openssl rand -base64 48` (должен быть ≥ 32 байт)
JWT_SECRET=                          # `openssl rand -base64 48`
POSTGRES_PASSWORD=
REDIS_PASSWORD=                      # `openssl rand -hex 24` (hex: goes into REDIS_URL)
REGISTRATION_MODE=invite             # open | invite
MAX_FILE_SIZE_MB=50
# Лимит всех загрузок на диске (байты), по умолчанию 50 GiB
STORAGE_MAX_TOTAL_BYTES=53687091200
# Offsite-копия бэкапов (rclone remote:path), пусто = только локально. TODO владелец.
OFFSITE_RCLONE_REMOTE=
