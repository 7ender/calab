# Скопировать в infra/docker/.env на хосте. Не коммитить.
# Основной домен: app./rtc./turn.<DOMAIN>. На стенде: colaba.gptunnel.ai
DOMAIN=calaba.example.com
# Запасной домен-алиас (те же три имени, опционально). На стенде: colaba.gptunnel.ru
DOMAIN_ALT=
# Временный третий набор имён на время переезда с другого домена (опционально), напр. 141-105-69-177.sslip.io
DOMAIN_LEGACY=
LIVEKIT_API_KEY=                     # "API" + `openssl rand -hex 6`, например APIa1b2c3d4e5f6
LIVEKIT_API_SECRET=                  # `openssl rand -base64 48` (должен быть ≥ 32 байт)
JWT_SECRET=                          # `openssl rand -base64 48`
POSTGRES_PASSWORD=
REGISTRATION_MODE=invite             # open | invite
MAX_FILE_SIZE_MB=50
