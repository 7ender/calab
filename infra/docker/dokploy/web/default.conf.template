# Повторяет поведение Caddy для веб-клиента (docs/06-deployment.md, «Веб-клиент», ADR-0015).
# Рендерится envsubst-ом официального образа nginx: подставляется только ${DOMAIN}.

# /assets/* (хэшированные файлы Vite) — immutable; остальное (index.html, SPA-маршруты) — no-cache.
# add_header без "always" не добавляется к 404, поэтому отсутствующий ассет не кэшируется.
map $uri $calab_cache_control {
    default     "no-cache";
    ~^/assets/  "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json
               application/manifest+json image/svg+xml application/wasm text/plain;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' wss://rtc.${DOMAIN} https://rtc.${DOMAIN}; img-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Permissions-Policy "microphone=(self), display-capture=(self), speaker-selection=(self), autoplay=(self)" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control $calab_cache_control;

    # отсутствующий ассет — честный 404, а не index.html
    location /assets/ {
        try_files $uri =404;
    }

    # SPA-fallback
    location / {
        try_files $uri /index.html;
    }
}
