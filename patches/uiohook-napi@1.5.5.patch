@@ -369,6 +369,23 @@ static inline void process_key_released(uint64_t timestamp, CGEventRef event_ref
     dispatch_event(&event);
 }
 
+/* Calaba patch: hardware Caps Lock on macOS only produces kCGEventFlagsChanged (once per
+ * press, when the lock state flips); the NX_SYSDEFINED path below never sees it. Report the
+ * state flip as VC_CAPS_LOCK_STATE so a client can use Caps Lock as a toggle key. */
+static inline void process_caps_lock_state(uint64_t timestamp, bool on) {
+    event.time = timestamp;
+    event.reserved = 0x00;
+
+    event.type = on ? EVENT_KEY_PRESSED : EVENT_KEY_RELEASED;
+    event.mask = get_modifiers();
+
+    event.data.keyboard.keycode = VC_CAPS_LOCK_STATE;
+    event.data.keyboard.rawcode = kVK_CapsLock;
+    event.data.keyboard.keychar = CHAR_UNDEFINED;
+
+    dispatch_event(&event);
+}
+
 static inline void process_modifier_changed(uint64_t timestamp, CGEventRef event_ref) {
     CGEventFlags event_mask = CGEventGetFlags(event_ref);
     UInt64 keycode = CGEventGetIntegerValueField(event_ref, kCGKeyboardEventKeycode);
@@ -468,6 +485,7 @@ static inline void process_modifier_changed(uint64_t timestamp, CGEventRef event
             process_key_released(timestamp, event_ref);
         }
     } else if (keycode == kVK_CapsLock) {
+        process_caps_lock_state(timestamp, (event_mask & kCGEventFlagMaskAlphaShift) != 0);
         if (current_modifiers & MASK_CAPS_LOCK) {
             // Process as a key pressed event.
             unset_modifier_mask(MASK_CAPS_LOCK);
@@ -958,7 +976,8 @@ CGEventRef hook_event_proc(CGEventTapProxy tap_proxy, CGEventType type, CGEventR
                     unset_modifier_mask(MOUSE_BUTTON5);
                 }
 
-                process_button_pressed(timestamp, event_ref, button);
+                // Calaba patch: upstream fired «pressed» here, so side buttons never released.
+                process_button_released(timestamp, event_ref, button);
             }
             break;
 
