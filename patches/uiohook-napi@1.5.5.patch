+/* Calaba patch: hardware Caps Lock on macOS only produces kCGEventFlagsChanged (once per
+ * press, when the lock state flips); the NX_SYSDEFINED path below never sees it. Report the
+ * state flip as VC_CAPS_LOCK_STATE so a client can use Caps Lock as a toggle key. */
+static inline void process_caps_lock_state(uint64_t timestamp, bool on) {
+    event.time = timestamp;
+    event.reserved = 0x00;
+
+    event.type = on ? EVENT_KEY_PRESSED : EVENT_KEY_RELEASED;
+    event.mask = get_modifiers();
+
+    event.data.keyboard.keycode = VC_CAPS_LOCK_STATE;
+    event.data.keyboard.rawcode = kVK_CapsLock;
+    event.data.keyboard.keychar = CHAR_UNDEFINED;
+
+    dispatch_event(&event);
+}
+
+/* ---- Calaba patch: IOHIDManager keyboard listener ------------------------------------------
+ *
+ * With «Use Caps Lock to switch input source» (default once a second layout is added) a short Caps
+ * Lock press only switches the layout: the lock state never flips, so the CGEventTap sees neither
+ * kCGEventFlagsChanged nor NX_SYSDEFINED, and a hidutil Caps->F18 remap did not reach the tap either
+ * (owner, 0.2.1). The physical key is still visible at the HID level, which is what Discord reads.
+ *
+ * An IOHIDManager on the hook's own run loop (same thread as the tap, so dispatch is serialized with
+ * tap events) reports Caps Lock (page 0x07, usage 0x39) down/up as VC_CAPS_LOCK with the `reserved`
+ * bit CALABA_EVENT_SOURCE_HID. The client dedups against tap events of the same key. Opening the
+ * manager needs Input Monitoring (kIOHIDRequestTypeListenEvent); when undetermined it is requested
+ * off-thread (IOHIDRequestAccess may wait for the user) and the open is retried afterwards. */
+
+UIOHOOK_API const char calaba_hid_marker[] = "CALABA_HID_CAPS_V1";
+
+enum { CALABA_HID_OFF, CALABA_HID_STARTING, CALABA_HID_RUNNING, CALABA_HID_DENIED, CALABA_HID_ERROR };
+
+static IOHIDManagerRef calaba_hid_manager = NULL;
+static volatile int calaba_hid_state = CALABA_HID_OFF;
+static volatile int calaba_hid_device_count = 0;
+static bool calaba_hid_requested = false;
+static CFRunLoopSourceRef calaba_hid_retry_source = NULL;
+static pthread_mutex_t calaba_hid_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static IOHIDAccessType calaba_hid_check_access(void) {
+    if (__builtin_available(macOS 10.15, *)) {
+        return IOHIDCheckAccess(kIOHIDRequestTypeListenEvent);
+    }
+    return kIOHIDAccessTypeGranted;
+}
+
+UIOHOOK_API const char* calaba_hid_status(void) {
+    switch (calaba_hid_state) {
+        case CALABA_HID_STARTING: return "starting";
+        case CALABA_HID_RUNNING: return "running";
+        case CALABA_HID_DENIED: return "denied";
+        case CALABA_HID_ERROR: return "error";
+        default: return "off";
+    }
+}
+
+UIOHOOK_API const char* calaba_hid_access(void) {
+    switch (calaba_hid_check_access()) {
+        case kIOHIDAccessTypeGranted: return "granted";
+        case kIOHIDAccessTypeDenied: return "denied";
+        default: return "unknown";
+    }
+}
+
+UIOHOOK_API int calaba_hid_devices(void) {
+    return calaba_hid_device_count;
+}
+
+UIOHOOK_API void calaba_hid_retry(void) {
+    pthread_mutex_lock(&calaba_hid_mutex);
+    if (calaba_hid_retry_source != NULL && event_loop != NULL) {
+        CFRunLoopSourceSignal(calaba_hid_retry_source);
+        CFRunLoopWakeUp(event_loop);
+    }
+    pthread_mutex_unlock(&calaba_hid_mutex);
+}
+
+static void calaba_hid_value(void *context, IOReturn result, void *sender, IOHIDValueRef value) {
+    if (result != kIOReturnSuccess || value == NULL) return;
+    IOHIDElementRef element = IOHIDValueGetElement(value);
+    if (element == NULL) return;
+    uint32_t page = IOHIDElementGetUsagePage(element);
+    uint32_t usage = IOHIDElementGetUsage(element);
+    if (page != kHIDPage_KeyboardOrKeypad || usage != kHIDUsage_KeyboardCapsLock) return;
+
+    struct timeval now;
+    gettimeofday(&now, NULL);
+
+    // A local event, kept apart from the tap's static `event` (same thread, but not the same record).
+    uiohook_event hid_event;
+    memset(&hid_event, 0, sizeof(hid_event));
+    hid_event.time = (uint64_t) now.tv_sec * 1000 + (uint64_t) now.tv_usec / 1000;
+    hid_event.reserved = CALABA_EVENT_SOURCE_HID;
+    hid_event.type = IOHIDValueGetIntegerValue(value) != 0 ? EVENT_KEY_PRESSED : EVENT_KEY_RELEASED;
+    hid_event.mask = get_modifiers();
+    hid_event.data.keyboard.keycode = VC_CAPS_LOCK;
+    hid_event.data.keyboard.rawcode = (uint16_t) usage;
+    hid_event.data.keyboard.keychar = CHAR_UNDEFINED;
+
+    dispatch_event(&hid_event);
+}
+
+static void calaba_hid_device_added(void *context, IOReturn result, void *sender, IOHIDDeviceRef device) {
+    calaba_hid_device_count++;
+}
+
+static void calaba_hid_device_removed(void *context, IOReturn result, void *sender, IOHIDDeviceRef device) {
+    if (calaba_hid_device_count > 0) calaba_hid_device_count--;
+}
+
+static CFMutableDictionaryRef calaba_hid_match(CFStringRef page_key, int page, CFStringRef usage_key, int usage) {
+    CFMutableDictionaryRef dict = CFDictionaryCreateMutable(kCFAllocatorDefault, 2,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    if (dict == NULL) return NULL;
+    CFNumberRef page_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &page);
+    CFNumberRef usage_num = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &usage);
+    CFDictionarySetValue(dict, page_key, page_num);
+    CFDictionarySetValue(dict, usage_key, usage_num);
+    CFRelease(page_num);
+    CFRelease(usage_num);
+    return dict;
+}
+
+static void calaba_hid_request_access(void *context) {
+    // May block until the user answers the Input Monitoring prompt: never on the hook thread.
+    if (__builtin_available(macOS 10.15, *)) {
+        IOHIDRequestAccess(kIOHIDRequestTypeListenEvent);
+    }
+    calaba_hid_retry();
+}
+
+// Runs on the hook run loop (the retry source's perform callback).
+static void calaba_hid_open(void *info) {
+    if (calaba_hid_manager != NULL || event_loop == NULL) return;
+
+    IOHIDAccessType access = calaba_hid_check_access();
+    if (access == kIOHIDAccessTypeDenied) {
+        calaba_hid_state = CALABA_HID_DENIED;
+        logger(LOG_LEVEL_WARN, "%s [%u]: %s: Input Monitoring denied.\n", __FUNCTION__, __LINE__, calaba_hid_marker);
+        return;
+    }
+    if (access == kIOHIDAccessTypeUnknown && !calaba_hid_requested) {
+        calaba_hid_requested = true;
+        calaba_hid_state = CALABA_HID_STARTING;
+        dispatch_async_f(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), NULL, calaba_hid_request_access);
+        return;
+    }
+
+    IOHIDManagerRef manager = IOHIDManagerCreate(kCFAllocatorDefault, kIOHIDOptionsTypeNone);
+    if (manager == NULL) {
+        calaba_hid_state = CALABA_HID_ERROR;
+        return;
+    }
+
+    CFMutableDictionaryRef devices = calaba_hid_match(CFSTR(kIOHIDDeviceUsagePageKey), kHIDPage_GenericDesktop,
+            CFSTR(kIOHIDDeviceUsageKey), kHIDUsage_GD_Keyboard);
+    IOHIDManagerSetDeviceMatching(manager, devices);
+    if (devices != NULL) CFRelease(devices);
+
+    CFMutableDictionaryRef values = calaba_hid_match(CFSTR(kIOHIDElementUsagePageKey), kHIDPage_KeyboardOrKeypad,
+            CFSTR(kIOHIDElementUsageKey), kHIDUsage_KeyboardCapsLock);
+    IOHIDManagerSetInputValueMatching(manager, values);
+    if (values != NULL) CFRelease(values);
+
+    IOHIDManagerRegisterDeviceMatchingCallback(manager, calaba_hid_device_added, NULL);
+    IOHIDManagerRegisterDeviceRemovalCallback(manager, calaba_hid_device_removed, NULL);
+    IOHIDManagerRegisterInputValueCallback(manager, calaba_hid_value, NULL);
+    IOHIDManagerScheduleWithRunLoop(manager, event_loop, kCFRunLoopDefaultMode);
+
+    IOReturn status = IOHIDManagerOpen(manager, kIOHIDOptionsTypeNone);
+    if (status != kIOReturnSuccess) {
+        IOHIDManagerUnscheduleFromRunLoop(manager, event_loop, kCFRunLoopDefaultMode);
+        CFRelease(manager);
+        calaba_hid_device_count = 0;
+        calaba_hid_state = status == kIOReturnNotPermitted ? CALABA_HID_DENIED : CALABA_HID_ERROR;
+        logger(LOG_LEVEL_WARN, "%s [%u]: %s: IOHIDManagerOpen failed: %#X.\n", __FUNCTION__, __LINE__, calaba_hid_marker, status);
+        return;
+    }
+
+    calaba_hid_manager = manager;
+    calaba_hid_state = CALABA_HID_RUNNING;
+}
+
+// hook_run, before CFRunLoopRun: the open itself runs inside the loop, so the hook start is not delayed.
+static void calaba_hid_setup(void) {
+    CFRunLoopSourceContext context = {
+        .version = 0, .info = NULL, .retain = NULL, .release = NULL, .copyDescription = NULL,
+        .equal = NULL, .hash = NULL, .schedule = NULL, .cancel = NULL, .perform = calaba_hid_open
+    };
+    calaba_hid_requested = false;
+    calaba_hid_state = CALABA_HID_STARTING;
+    pthread_mutex_lock(&calaba_hid_mutex);
+    calaba_hid_retry_source = CFRunLoopSourceCreate(kCFAllocatorDefault, 0, &context);
+    if (calaba_hid_retry_source != NULL) {
+        CFRunLoopAddSource(event_loop, calaba_hid_retry_source, kCFRunLoopDefaultMode);
+        CFRunLoopSourceSignal(calaba_hid_retry_source);
+    } else {
+        calaba_hid_state = CALABA_HID_ERROR;
+    }
+    pthread_mutex_unlock(&calaba_hid_mutex);
+}
+
+// hook_run, after CFRunLoopRun returned (same thread).
+static void calaba_hid_teardown(void) {
+    pthread_mutex_lock(&calaba_hid_mutex);
+    if (calaba_hid_retry_source != NULL) {
+        CFRunLoopRemoveSource(event_loop, calaba_hid_retry_source, kCFRunLoopDefaultMode);
+        CFRunLoopSourceInvalidate(calaba_hid_retry_source);
+        CFRelease(calaba_hid_retry_source);
+        calaba_hid_retry_source = NULL;
+    }
+    pthread_mutex_unlock(&calaba_hid_mutex);
+    if (calaba_hid_manager != NULL) {
+        IOHIDManagerUnscheduleFromRunLoop(calaba_hid_manager, event_loop, kCFRunLoopDefaultMode);
+        IOHIDManagerClose(calaba_hid_manager, kIOHIDOptionsTypeNone);
+        CFRelease(calaba_hid_manager);
+        calaba_hid_manager = NULL;
+    }
+    calaba_hid_device_count = 0;
+    calaba_hid_state = CALABA_HID_OFF;
+}
