diff --git a/libuiohook/src/darwin/input_hook.c b/libuiohook/src/darwin/input_hook.c
index e6cd6cec9c3c5a26cda5eccc5fe9eb087752eef9..0197b99122f75b56842dfbaa36c4a422496aa653 100644
