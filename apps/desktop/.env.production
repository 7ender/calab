# Build-time defaults for packaged desktop builds (electron-vite loads this for `build`).
# Configuration, not code: override with env at build/run time (CALABA_SERVER_URL wins at runtime).
MAIN_VITE_DEFAULT_SERVER_URL=https://app.calab.ru
# The pinned update feed: the only host updates are downloaded and installed from automatically
# (review pass 3 B1; https only). Packaged builds only — `electron-vite dev` (development mode)
# does not load this file, so dev builds stay notify-only. The process env wins over this file
# (scripts/build-release.sh passes UPDATE_FEED as MAIN_VITE_UPDATE_FEED).
MAIN_VITE_UPDATE_FEED=https://releases.calab.ru/
# Explicit connect-src safety net for LiveKit/TURN (P0 bug 1, 0.2.1): the renderer CSP also
# derives *.<parent domain> from the server URL, this list keeps working if that changes.
# The process env CALABA_CSP_CONNECT wins at runtime.
MAIN_VITE_CSP_CONNECT="wss://rtc.calab.ru https://rtc.calab.ru wss://turn.calab.ru https://turn.calab.ru"
# Plans on the landing page: the «Тариф» tab links here (ADR-0024); unset = no link.
VITE_PRICING_URL=https://calab.ru/#pricing
